generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_PRISMA_DATABASE_URL")
}


model TutorApplication {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  phone        String
  location     String
  education    String
  experience   String
  availability String
  hasTablet    Boolean
  why          String

  testName     String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  testSessions TestSession[]

  @@index([email])
}
model TestSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()::text"))
  tutorApplicationId  String    @map("tutor_application_id")
  tutorApplication    TutorApplication @relation(fields: [tutorApplicationId], references: [id], onDelete: Cascade)
  testName            String?   @map("test_name")
  questions           Json
  answers             Json?
  score               Int?
  total               Int       @default(40)  @map("total")
  startedAt           DateTime  @default(now()) @map("started_at")
  submittedAt         DateTime? @map("submitted_at")

  @@index([tutorApplicationId])
  @@map("test_sessions")
}

model ParentRegistration {
  id          String   @id @default(cuid())

  parentName  String
  parentEmail String   @unique
  parentPhone String
  location    String

  childName   String
  childClass  String
  examType    String?
  support     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentTestSessions StudentTestSession[]

  @@index([parentEmail])
}

model StudentTestSession {
  id                   String   @id @default(dbgenerated("gen_random_uuid()::text"))
  parentRegistrationId String   @map("parent_registration_id")
  parentRegistration   ParentRegistration @relation(fields: [parentRegistrationId], references: [id], onDelete: Cascade)

  studentName          String?  @map("student_name")
  classLevel           String   @map("class_level")

  questions            Json
  answers              Json?

  // Marked by hand — score stays null until a tutor reviews the paper.
  markingStatus        String   @default("PENDING") @map("marking_status")
  score                Int?
  total                Int
  markedAt             DateTime? @map("marked_at")
  markedBy             String?   @map("marked_by")

  startedAt            DateTime  @default(now()) @map("started_at")
  submittedAt          DateTime? @map("submitted_at")

  @@index([parentRegistrationId])
  @@index([markingStatus])
  @@map("student_test_sessions")
}

